# ===================================================================
# Vakil Lead Flow CRM - Environment Variables Template
# ===================================================================
# Copy this file to .env or .env.local and populate with your production credentials.
# NEVER commit your actual .env file or production secret tokens to Git!
# ===================================================================

# --- Frontend & Vite Configuration ---
# Virtual Pilot DID provided by Tata Tele Business Services (TTBS) Smartflo
VITE_SMARTFLO_PILOT_NUMBER=917900000000

# Default verified agent/lawyer phone for two-way call bridging (10-digit Indian number)
VITE_SMARTFLO_DEFAULT_AGENT_PHONE=9800000001

# Tata Smartflo API Host
VITE_SMARTFLO_API_HOST=api-smartflo.tatateleservices.com

# Tata Smartflo JWT Bearer API Token (obtain from Smartflo Portal -> API Connect)
VITE_SMARTFLO_JWT_TOKEN=your_smartflo_jwt_token_here

# Web Push Notification (VAPID) Public Key for Browser Notifications
VITE_VAPID_PUBLIC_KEY=BM_REPLACE_WITH_YOUR_PRODUCTION_VAPID_PUBLIC_KEY

# Optional default password for demo/staging logins
VITE_DEFAULT_AUTH_PASSWORD=Password@123

# --- Backend Telephony Server (Standalone Node / Express / Lambda) ---
PORT=3001
FALLBACK_AGENT_PHONE=919800000000
SMARTFLO_PILOT_NUMBER=917900000000
SMARTFLO_API_TOKEN=your_smartflo_jwt_token_here

# Agent Directory Fallbacks for Inbound API Dialplan
AGENT_U1_PHONE=9800000001
AGENT_U2_PHONE=9800000002
AGENT_U3_PHONE=9800000003
AGENT_U4_PHONE=9800000004
AGENT_U5_PHONE=9800000005

# Optional API Base URL for Frontend (leave blank if frontend & backend are on same origin)
VITE_API_URL=

# --- MySQL Database Configuration ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=vakil_lead_flow
DATABASE_URL=mysql://root:your_mysql_password_here@localhost:3306/vakil_lead_flow

# --- Kapso AI WhatsApp Cloud API Configuration ---
# API Key obtained from Kapso AI Portal (https://docs.kapso.ai/docs/introduction)
KAPSO_API_KEY=your_kapso_api_key_here

# Meta WhatsApp Business Phone Number ID provisioned in Kapso
KAPSO_PHONE_NUMBER_ID=your_kapso_phone_number_id_here

# Kapso WhatsApp API Base URL (defaults to https://api.kapso.ai/meta/whatsapp/v24.0)
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0

# Webhook verification secret token for Kapso webhook challenge
KAPSO_WEBHOOK_VERIFY_TOKEN=your_kapso_verify_token_here

# VAPID Private Key for Backend Web Push Dispatch
VAPID_PRIVATE_KEY=your_vapid_private_key_here
